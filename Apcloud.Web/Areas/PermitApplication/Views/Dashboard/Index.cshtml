@{
    ViewData["Title"] = "Permit Dashboard";
    var firstName = (User.Identity?.Name ?? "there")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .FirstOrDefault() ?? "there";
}

<div class="page-header d-print-none dashboard-header">
    <div class="row g-3 align-items-center">
        <div class="col">
            <div class="page-pretitle">Permit Application overview</div>
            <h1 class="page-title">Welcome back, @firstName</h1>
            <p class="text-secondary mt-2 mb-0">Monitor applications, approvals, and permit activity from one place.</p>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <div class="btn-list">
                <button type="button" class="btn btn-outline-secondary">
                    <svg class="icon"><use href="#icon-download" /></svg>
                    Export report
                </button>
                <a asp-area="PermitApplication" asp-controller="PermitApplication" asp-action="Index" class="btn btn-primary">
                    <svg class="icon"><use href="#icon-plus" /></svg>
                    New application
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row row-deck row-cards mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div><div class="metric-label">Total applications</div><div class="metric-value">1,482</div></div>
                    <span class="metric-icon bg-blue-lt ms-auto"><svg class="icon"><use href="#icon-files" /></svg></span>
                </div>
                <div class="d-flex align-items-center mt-3"><span class="trend trend-up"><svg class="icon"><use href="#icon-arrow-up" /></svg> 12.5%</span><span class="text-secondary ms-2">vs last month</span></div>
                <div class="spark-bars" aria-hidden="true"><i style="height:32%"></i><i style="height:44%"></i><i style="height:40%"></i><i style="height:58%"></i><i style="height:52%"></i><i style="height:75%"></i><i style="height:68%"></i><i style="height:92%"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div><div class="metric-label">Pending review</div><div class="metric-value">86</div></div>
                    <span class="metric-icon bg-yellow-lt ms-auto"><svg class="icon"><use href="#icon-clock" /></svg></span>
                </div>
                <div class="d-flex align-items-center mt-3"><span class="trend trend-down"><svg class="icon"><use href="#icon-arrow-down" /></svg> 4.1%</span><span class="text-secondary ms-2">vs last week</span></div>
                <div class="spark-bars orange" aria-hidden="true"><i style="height:82%"></i><i style="height:74%"></i><i style="height:78%"></i><i style="height:62%"></i><i style="height:68%"></i><i style="height:55%"></i><i style="height:58%"></i><i style="height:48%"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div><div class="metric-label">Approved</div><div class="metric-value">1,284</div></div>
                    <span class="metric-icon bg-green-lt ms-auto"><svg class="icon"><use href="#icon-check" /></svg></span>
                </div>
                <div class="d-flex align-items-center mt-3"><span class="trend trend-up"><svg class="icon"><use href="#icon-arrow-up" /></svg> 8.2%</span><span class="text-secondary ms-2">vs last month</span></div>
                <div class="spark-bars green" aria-hidden="true"><i style="height:30%"></i><i style="height:38%"></i><i style="height:50%"></i><i style="height:47%"></i><i style="height:62%"></i><i style="height:73%"></i><i style="height:79%"></i><i style="height:91%"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div><div class="metric-label">Expiring soon</div><div class="metric-value">19</div></div>
                    <span class="metric-icon bg-red-lt ms-auto"><svg class="icon"><use href="#icon-alert" /></svg></span>
                </div>
                <div class="d-flex align-items-center mt-3"><span class="text-danger fw-semibold">Needs attention</span><span class="text-secondary ms-2">next 30 days</span></div>
                <div class="spark-bars purple" aria-hidden="true"><i style="height:36%"></i><i style="height:48%"></i><i style="height:42%"></i><i style="height:54%"></i><i style="height:59%"></i><i style="height:65%"></i><i style="height:74%"></i><i style="height:86%"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row row-deck row-cards mb-4">
    <div class="col-lg-8">
        <div class="card revenue-card h-100">
            <div class="card-header border-0 pb-0">
                <div><h3 class="card-title">Application volume</h3><p class="card-subtitle">Applications received during the last 30 days</p></div>
                <div class="card-actions"><span class="badge bg-blue-lt">Last 30 days</span></div>
            </div>
            <div class="card-body pt-3">
                <div class="chart-summary d-flex align-items-end gap-3 mb-3"><strong>428</strong><span class="trend trend-up mb-1"><svg class="icon"><use href="#icon-arrow-up" /></svg> 14.2%</span></div>
                <div class="revenue-chart" role="img" aria-label="Application volume increased during the last 30 days">
                    <div class="chart-y-axis"><span>120</span><span>90</span><span>60</span><span>30</span><span>0</span></div>
                    <svg viewBox="0 0 760 250" preserveAspectRatio="none" aria-hidden="true">
                        <defs><linearGradient id="application-chart-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#206bc4" stop-opacity=".24"/><stop offset="1" stop-color="#206bc4" stop-opacity="0"/></linearGradient></defs>
                        <g class="chart-grid"><line x1="0" y1="10" x2="760" y2="10"/><line x1="0" y1="67" x2="760" y2="67"/><line x1="0" y1="124" x2="760" y2="124"/><line x1="0" y1="181" x2="760" y2="181"/><line x1="0" y1="238" x2="760" y2="238"/></g>
                        <path class="chart-area" d="M0 203 C45 190 62 210 105 182 S168 159 211 171 S279 129 321 145 S382 120 428 125 S490 91 532 103 S594 52 638 70 S704 33 760 28 L760 250 L0 250 Z"/>
                        <path class="chart-line" d="M0 203 C45 190 62 210 105 182 S168 159 211 171 S279 129 321 145 S382 120 428 125 S490 91 532 103 S594 52 638 70 S704 33 760 28"/>
                        <circle class="chart-point" cx="638" cy="70" r="5"/>
                    </svg>
                    <div class="chart-x-axis"><span>Aug 1</span><span>Aug 6</span><span>Aug 11</span><span>Aug 16</span><span>Aug 21</span><span>Aug 28</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header border-0"><div><h3 class="card-title">Permit status</h3><p class="card-subtitle">Distribution across all applications</p></div></div>
            <div class="card-body pt-2">
                <div class="traffic-donut mx-auto mb-4" aria-label="Approved permits account for 68 percent"><div><strong>1,482</strong><span>Total</span></div></div>
                <div class="traffic-list">
                    <div><span><i class="legend-dot bg-green"></i>Approved</span><strong>68%</strong></div>
                    <div><span><i class="legend-dot bg-yellow"></i>Pending review</span><strong>18%</strong></div>
                    <div><span><i class="legend-dot bg-blue"></i>In progress</span><strong>10%</strong></div>
                    <div><span><i class="legend-dot bg-red"></i>Changes required</span><strong>4%</strong></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row row-deck row-cards">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header border-0"><div><h3 class="card-title">Recent applications</h3><p class="card-subtitle">Latest submissions requiring attention</p></div><div class="card-actions"><button type="button" class="btn btn-sm btn-outline-secondary">View all</button></div></div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table order-table">
                    <thead><tr><th>Reference</th><th>Applicant</th><th>Permit type</th><th>Submitted</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        <tr><td><a href="#" class="fw-semibold">#PRM-2048</a><small>High priority</small></td><td><span class="avatar avatar-xs bg-blue-lt me-2">AP</span>Aarav Patel</td><td>Commercial operation</td><td>Today, 09:42</td><td><span class="badge bg-yellow-lt"><span class="status-dot bg-yellow me-1"></span>Review</span></td><td><button type="button" class="btn-action" aria-label="Application actions"><svg class="icon"><use href="#icon-dots" /></svg></button></td></tr>
                        <tr><td><a href="#" class="fw-semibold">#PRM-2047</a><small>Standard</small></td><td><span class="avatar avatar-xs bg-purple-lt me-2">SK</span>Sophia Kim</td><td>Site access</td><td>Today, 08:18</td><td><span class="badge bg-blue-lt"><span class="status-dot bg-blue me-1"></span>Assigned</span></td><td><button type="button" class="btn-action" aria-label="Application actions"><svg class="icon"><use href="#icon-dots" /></svg></button></td></tr>
                        <tr><td><a href="#" class="fw-semibold">#PRM-2046</a><small>Renewal</small></td><td><span class="avatar avatar-xs bg-green-lt me-2">NR</span>Nabin Rai</td><td>Work authorization</td><td>Yesterday, 16:35</td><td><span class="badge bg-green-lt"><span class="status-dot bg-green me-1"></span>Approved</span></td><td><button type="button" class="btn-action" aria-label="Application actions"><svg class="icon"><use href="#icon-dots" /></svg></button></td></tr>
                        <tr><td><a href="#" class="fw-semibold">#PRM-2045</a><small>Standard</small></td><td><span class="avatar avatar-xs bg-orange-lt me-2">ER</span>Elena Rossi</td><td>Temporary access</td><td>Yesterday, 14:02</td><td><span class="badge bg-red-lt"><span class="status-dot bg-red me-1"></span>Changes needed</span></td><td><button type="button" class="btn-action" aria-label="Application actions"><svg class="icon"><use href="#icon-dots" /></svg></button></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header border-0"><div><h3 class="card-title">Recent activity</h3><p class="card-subtitle">Updates from your team</p></div></div>
            <div class="card-body pt-1">
                <div class="activity-list">
                    <div class="activity-item"><span class="activity-icon bg-green-lt"><svg class="icon"><use href="#icon-check" /></svg></span><div><strong>Permit #PRM-2046 approved</strong><p>The final approval was recorded.</p><time>12 minutes ago</time></div></div>
                    <div class="activity-item"><span class="activity-icon bg-blue-lt"><svg class="icon"><use href="#icon-users" /></svg></span><div><strong>Application assigned</strong><p>#PRM-2047 was assigned to Maya.</p><time>34 minutes ago</time></div></div>
                    <div class="activity-item"><span class="activity-icon bg-yellow-lt"><svg class="icon"><use href="#icon-alert" /></svg></span><div><strong>Documents requested</strong><p>Additional documents are required.</p><time>1 hour ago</time></div></div>
                    <div class="activity-item"><span class="activity-icon bg-purple-lt"><svg class="icon"><use href="#icon-message" /></svg></span><div><strong>Applicant replied</strong><p>A new comment was added to #PRM-2045.</p><time>2 hours ago</time></div></div>
                </div>
            </div>
        </div>
    </div>
</div>
