@using Apcloud.Contracts.Permissions
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Risk Assessments";
    var modalLoadingOverlayEnabled = Configuration.GetValue("Ui:ModalLoadingOverlay:Enabled", true);
}

<span data-permission-scope data-permission-module="@ApplicationPermissions.PermitModule" data-permission-controller="PermitApplications" data-permission-action="Index" hidden></span>

<div class="page-header d-print-none dashboard-header">
    <div class="row g-3 align-items-center">
        <div class="col">
            <div class="page-pretitle">Permit Application</div>
            <h1 class="page-title">Draft Risk Assessments</h1>
            <p class="text-secondary mt-2 mb-0">Review and manage the risk assessments available to your account.</p>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <button type="button" class="btn btn-primary" data-risk-add data-requires-permission="@ApplicationPermissions.RiskAssessments.Create">
                <svg class="icon"><use href="#icon-plus" /></svg>
                Add risk assessment
            </button>
        </div>
    </div>
</div>

<div class="card server-data-grid risk-assessments-grid"
     data-server-grid
     data-server-sort="true"
     data-default-sort="issueDate"
     data-default-sort-direction="desc"
     data-url="risk-assessments"
     data-page-size="10"
     data-search-param="searchTerm"
     data-search-alias="search"
     data-row-expand="true"
     data-row-expand-when="hasPermitType"
     data-edit-statuses="Draft,Rejected"
     data-row-actions=""
     data-permission-actions="edit:@ApplicationPermissions.RiskAssessments.Edit">
    <div class="card-header server-grid-toolbar">
        <div class="server-grid-search" role="search">
            <div class="input-icon">
                <span class="input-icon-addon"><svg class="icon"><use href="#icon-search" /></svg></span>
                <input type="search" class="form-control" data-grid-search placeholder="Search assessments…" aria-label="Search risk assessments" autocomplete="off" />
            </div>
            <button type="button" class="btn btn-primary" data-grid-search-button>Search</button>
            <button type="button" class="btn btn-outline-secondary" data-grid-clear>Clear</button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label for="riskAssessmentPageSize" class="text-secondary small text-nowrap">Rows per page</label>
            <select id="riskAssessmentPageSize" class="form-select form-select-sm" data-grid-page-size>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>

    <div class="server-grid-state" data-grid-loading role="status">
        <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
        <span>Loading risk assessments…</span>
    </div>

    <div class="server-grid-state d-none" data-grid-error role="alert">
        <span class="server-grid-state-icon text-danger"><svg class="icon"><use href="#icon-alert" /></svg></span>
        <div><strong>Unable to load risk assessments</strong><p data-grid-error-message>The data could not be loaded.</p></div>
        <button type="button" class="btn btn-outline-danger ms-auto" data-grid-retry>Try again</button>
    </div>

    <div class="empty py-6 d-none" data-grid-empty>
        <div class="empty-icon"><svg class="icon"><use href="#icon-search" /></svg></div>
        <p class="empty-title">No risk assessments found</p>
        <p class="empty-subtitle text-secondary">Try changing the search term or add a new risk assessment.</p>
        <div class="empty-action"><button type="button" class="btn btn-primary" data-risk-add data-requires-permission="@ApplicationPermissions.RiskAssessments.Create"><svg class="icon"><use href="#icon-plus" /></svg>Add risk assessment</button></div>
    </div>

    <div class="d-none" data-grid-content>
        <div class="table-responsive server-grid-scroll">
            <table class="table table-vcenter card-table server-grid-table risk-assessment-table">
                <thead>
                    <tr data-grid-head>
                        @* Change the text inside a <th> to rename its heading. The
                           data-grid-column value must match the API property and is
                           also the validated server-side sorting key. Reorder or
                           remove a <th> to reorder or hide that column. *@
                        <th data-grid-column="riskAssessmentNumber">Assessment No.</th>
                        <th data-grid-column="issueDate">Issue date</th>
                        <th data-grid-column="permitIssuerName">Issuer</th>
                        <th data-grid-column="permitReceiverName">Receiver</th>
                        <th data-grid-column="areaResponsibleName">Responsible area</th>
                        <th data-grid-column="plannedStartDateTime">Planned start</th>
                        <th data-grid-column="plannedEndDateTime">Planned end</th>
                        <th data-grid-column="riskAssessmentStatus">Status</th>
                    </tr>
                </thead>
                <tbody data-grid-body></tbody>
            </table>
        </div>
        <div class="card-footer server-grid-footer">
            <p class="m-0 text-secondary" data-grid-summary></p>
            <ul class="pagination m-0 ms-auto" data-grid-pagination></ul>
        </div>
    </div>
</div>

<div class="modal modal-blur fade" id="riskAssessmentEditorModal" tabindex="-1"
     aria-labelledby="riskAssessmentEditorTitle" aria-hidden="true" data-risk-modal>
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form data-risk-form novalidate>
                <div class="modal-header align-items-start">
                    <div>
                        <div class="text-secondary small mb-1" data-risk-mode>Add risk assessment</div>
                        <h2 class="modal-title" id="riskAssessmentEditorTitle" data-risk-title>New risk assessment</h2>
                    </div>
                    <div class="risk-modal-header-meta ms-auto">
                        <div class="risk-modal-header-value">
                            <span>Risk assessment number</span>
                            <strong data-risk-header-number>Not assigned</strong>
                        </div>
                        <div class="risk-modal-header-value">
                            <span>Status</span>
                            <strong><span class="badge bg-blue-lt" data-risk-header-status>Draft</span></strong>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="risk-stepper" aria-label="Risk assessment form progress">
                    <button type="button" class="risk-step is-active" data-risk-step-button="0"><span>1</span><strong>Assessment &amp; work</strong><small>Details, people and scope</small></button>
                    <button type="button" class="risk-step" data-risk-step-button="1"><span>2</span><strong>Hazards &amp; permits</strong><small>Hazards and permit types</small></button>
                    <button type="button" class="risk-step" data-risk-step-button="2"><span>3</span><strong>Protection</strong><small>PPE and additional controls</small></button>
                    <button type="button" class="risk-step" data-risk-step-button="3"><span>4</span><strong>Final verification</strong><small>Review before submitting</small></button>
                </div>
                <div class="modal-body risk-editor-body">
                    @if (modalLoadingOverlayEnabled)
                    {
                        <div class="modal-body-loading-overlay d-none d-print-none" role="status" aria-live="polite" data-risk-loading-overlay>
                            <span class="spinner-border text-primary" aria-hidden="true"></span>
                            <strong>Loading risk assessment&hellip;</strong>
                        </div>
                    }
                    <div class="alert alert-danger d-none" role="alert" data-risk-error></div>
                    <input type="hidden" data-risk-id />

                    <section data-risk-step-panel="0">
                        <div class="risk-section-heading"><div><h3>Assessment and work details</h3><p>Identify the assessment, define the planned work window, and record the responsible people.</p></div><span class="badge bg-blue-lt">Step 1 of 4</span></div>
                        <div class="row g-3">
                            <div class="col-md-5"><label class="form-label" for="riskNumber">Risk assessment number</label><input id="riskNumber" class="form-control" maxlength="50" readonly placeholder="Assigned after the first save" data-risk-number /><div class="form-hint">Generated from the active fiscal year's RA prefix and next number.</div></div>
                            <div class="col-md-3"><label class="form-label required" for="riskIssueDate">Issue date</label><input id="riskIssueDate" type="date" class="form-control" required data-risk-issue-date /><div class="invalid-feedback">Select the issue date.</div></div>
                            <div class="col-md-4"><label class="form-label required" for="riskLocation">Location of work</label><input id="riskLocation" class="form-control" maxlength="255" required data-risk-location /><div class="invalid-feedback">Enter the work location.</div></div>
                            <div class="col-md-6"><label class="form-label" for="riskStart">Planned start</label><input id="riskStart" type="datetime-local" class="form-control" data-risk-start /></div>
                            <div class="col-md-6"><label class="form-label" for="riskEnd">Planned end</label><input id="riskEnd" type="datetime-local" class="form-control" data-risk-end /><div class="invalid-feedback">Planned end must be on or after planned start.</div></div>
                            <div class="col-12"><div class="risk-form-divider"><span>People and work scope</span></div></div>
                            <div class="col-md-4"><label class="form-label required" for="riskIssuer">Permit issuer</label><select id="riskIssuer" class="form-select" required data-risk-issuer><option value="">Loading users…</option></select><div class="invalid-feedback">Select the permit issuer.</div></div>
                            <div class="col-md-4"><label class="form-label required" for="riskReceiver">Permit receiver</label><select id="riskReceiver" class="form-select" required data-risk-receiver><option value="">Loading users…</option></select><div class="invalid-feedback">Select the permit receiver.</div></div>
                            <div class="col-md-4"><label class="form-label required" for="riskResponsible">Area responsible</label><input id="riskResponsible" class="form-control" maxlength="100" required data-risk-responsible /><div class="invalid-feedback">Enter the responsible person or area.</div></div>
                            <div class="col-12"><label class="form-label" for="riskDescription">Description of work</label><textarea id="riskDescription" class="form-control" rows="4" data-risk-description></textarea><div class="form-hint">Describe the activity, equipment, work method, and boundaries.</div></div>
                            <div class="col-12"><label class="form-label" for="riskInstructions">Special instructions</label><textarea id="riskInstructions" class="form-control" rows="3" data-risk-instructions></textarea></div>
                        </div>
                    </section>

                    <section class="d-none" data-risk-step-panel="1">
                        <div class="risk-section-heading"><div><h3>Hazards and special permits</h3><p>Select every applicable item. Special permits are loaded from the PermitType category.</p></div><span class="badge bg-blue-lt">Step 2 of 4</span></div>
                        <div class="row g-4">
                            <div class="col-lg-6"><div class="risk-selection-card"><h4>Hazard categories</h4><p class="text-secondary small">Known sources of harm associated with this work.</p><div class="risk-option-grid" data-risk-options="hazardCategories"><span class="spinner-border spinner-border-sm"></span> Loading options…</div></div></div>
                            <div class="col-lg-6"><div class="risk-selection-card"><h4>Special permits</h4><p class="text-secondary small">Additional permit controls required for the activity.</p><div class="risk-option-grid" data-risk-options="specialPermits"><span class="spinner-border spinner-border-sm"></span> Loading options…</div></div></div>
                        </div>
                    </section>

                    <section class="d-none" data-risk-step-panel="2">
                        <div class="risk-section-heading"><div><h3>Protective measures</h3><p>Select the required PPE and record any additional equipment or protection measures.</p></div><span class="badge bg-blue-lt">Step 3 of 4</span></div>
                        <div class="row g-4">
                            <div class="col-lg-6">
                                <div class="risk-protection-column">
                                    <div class="risk-selection-card"><h4>Personal protective equipment</h4><div class="risk-option-grid" data-risk-options="personalProtectiveEquipment"><span class="spinner-border spinner-border-sm"></span> Loading options…</div></div>
                                    <div><label class="form-label" for="riskOtherPpe">Other equipment or PPE</label><textarea id="riskOtherPpe" class="form-control" rows="3" maxlength="500" data-risk-other-ppe></textarea><div class="form-hint">Maximum 500 characters.</div></div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="risk-protection-column">
                                    <div class="risk-selection-card"><h4>Additional protective measures</h4><div class="risk-option-grid" data-risk-options="additionalPpe"><span class="spinner-border spinner-border-sm"></span> Loading options…</div></div>
                                    <div><label class="form-label" for="riskOtherMeasures">Other protection measures</label><textarea id="riskOtherMeasures" class="form-control" rows="3" maxlength="500" data-risk-other-measures></textarea><div class="form-hint">Maximum 500 characters.</div></div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="d-none risk-verification-panel" data-risk-step-panel="3">
                        <div class="risk-section-heading"><div><h3>Final verification</h3><p>Review all assessment information carefully before submitting the form.</p></div><span class="badge bg-blue-lt">Step 4 of 4</span></div>
                        <div data-risk-review></div>
                    </section>
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary d-none" data-risk-previous>Previous</button>
                        <button type="button" class="btn btn-primary" data-risk-next><span data-risk-next-label>Save &amp; continue</span><span class="d-none" data-risk-next-saving><span class="spinner-border spinner-border-sm me-2"></span>Saving…</span></button>
                        <button type="submit" class="btn btn-success d-none" data-risk-save data-requires-permission="@ApplicationPermissions.RiskAssessments.Create,@ApplicationPermissions.RiskAssessments.Edit"><svg class="icon me-1"><use href="#icon-check" /></svg><span data-risk-save-label>Submit</span><span class="d-none" data-risk-saving><span class="spinner-border spinner-border-sm me-2"></span>Submitting…</span></button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal modal-blur fade" id="permitApplicationEditorModal" tabindex="-1"
     aria-labelledby="permitApplicationEditorTitle" aria-hidden="true" data-permit-editor-modal>
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form data-permit-editor-form novalidate>
                <div class="modal-header">
                    <div>
                        <div class="text-secondary small" data-permit-editor-mode>Edit permit application</div>
                        <h2 class="modal-title" id="permitApplicationEditorTitle" data-permit-editor-title>Permit application</h2>
                    </div>
                    <button type="button" class="btn-close d-print-none" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body permit-editor-body">
                    @if (modalLoadingOverlayEnabled)
                    {
                        <div class="modal-body-loading-overlay d-none d-print-none" role="status" aria-live="polite" data-permit-loading-overlay>
                            <span class="spinner-border text-primary" aria-hidden="true"></span>
                            <strong>Loading permit application&hellip;</strong>
                        </div>
                    }
                    <div class="alert alert-danger d-none d-print-none" role="alert" data-permit-editor-error></div>
                    <div class="permit-print-heading d-none d-print-block">
                        <h1 data-permit-print-title>Permit application</h1>
                        <p>Permit application preview</p>
                    </div>
                    <input type="hidden" data-permit-id />
                    <div class="row g-3">
                        <div class="col-md-3"><label class="form-label">Risk assessment number</label><input class="form-control" readonly data-permit-risk-number /></div>
                        <div class="col-md-3"><label class="form-label">Permit number</label><input class="form-control" readonly data-permit-number /></div>
                        <div class="col-md-3"><label class="form-label">Permit type</label><input class="form-control" readonly data-permit-type /></div>
                        <div class="col-md-3"><label class="form-label">Permit status</label><input class="form-control" readonly data-permit-status /></div>
                        <div class="col-md-4"><label class="form-label required">Issue date</label><input type="date" class="form-control" required data-permit-issue-date /></div>
                        <div class="col-md-4"><label class="form-label">Planned start date/time</label><input type="datetime-local" class="form-control" data-permit-planned-start /></div>
                        <div class="col-md-4"><label class="form-label">Planned end date/time</label><input type="datetime-local" class="form-control" data-permit-planned-end /></div>
                        <div class="col-md-4"><label class="form-label required">Permit issuer</label><select class="form-select" required data-permit-issuer><option value="">Loading users…</option></select></div>
                        <div class="col-md-4"><label class="form-label">Issuer contact</label><input class="form-control" readonly data-permit-issuer-contact /></div>
                        <div class="col-md-4"><label class="form-label required">Permit receiver</label><select class="form-select" required data-permit-receiver><option value="">Loading users…</option></select></div>
                        <div class="col-md-4"><label class="form-label">Receiver contact</label><input class="form-control" readonly data-permit-receiver-contact /></div>
                        <div class="col-12"><label class="form-label required">Work location</label><input class="form-control" maxlength="500" required data-permit-work-location /></div>
                        <div class="col-12"><label class="form-label required">Work description</label><textarea class="form-control" rows="3" required data-permit-work-description></textarea></div>
                        <div class="col-md-6"><label class="form-label">Special instructions</label><textarea class="form-control" rows="3" data-permit-special-instructions></textarea></div>
                        <div class="col-md-6"><label class="form-label">Work height below surface</label><input class="form-control" rows="3" maxlength="200" data-permit-work-height /></div>
                        <div class="col-12"><label class="form-label">Completion of works</label><textarea class="form-control" rows="2" maxlength="500" data-permit-completion></textarea></div>
                    </div>

                    <section class="mt-4" data-permit-hot-work>
                        <div class="permit-extension-heading">
                            <div><h3>HOT_WORK controls</h3><p>Selections are saved in the HOT_WORK permit extension tables.</p></div>
                            <span class="badge bg-orange-lt">HOT_WORK</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-lg-4"><div class="permit-extension-card"><h4>Inspection prior to commencement</h4><div data-permit-options="inspectionPriorToCommencement"></div></div></div>
                            <div class="col-lg-4"><div class="permit-extension-card"><h4>Works on wall</h4><div data-permit-options="worksOnWall"></div></div></div>
                            <div class="col-lg-4"><div class="permit-extension-card"><h4>Working in confined space</h4><div data-permit-options="workingInConfinedSpace"></div></div></div>
                        </div>
                    </section>
                    <div class="alert alert-info mt-4 d-none" data-permit-unsupported-preview>
                        A type-specific editor has not yet been configured for this permit type. Common details are shown in preview mode.
                    </div>
                </div>
                <div class="modal-footer d-print-none justify-content-between">
                    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary d-none" data-permit-print data-requires-permission="@ApplicationPermissions.PermitApplications.Print">
                        <svg class="icon"><use href="#icon-printer" /></svg> Print / Save PDF
                    </button>
                        <button type="submit" class="btn btn-outline-primary" data-permit-save data-requires-permission="@ApplicationPermissions.PermitApplications.Edit">
                        <span data-permit-save-label>Save draft</span>
                        <span class="d-none" data-permit-saving><span class="spinner-border spinner-border-sm me-2"></span>Saving…</span>
                    </button>
                        <button type="button" class="btn btn-primary" data-permit-finalize data-requires-permission="@ApplicationPermissions.PermitApplications.Finalize">
                        <span data-permit-finalize-label>Finalize</span>
                        <span class="d-none" data-permit-finalizing><span class="spinner-border spinner-border-sm me-2"></span>Finalizing…</span>
                    </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/risk-assessment-editor.js" asp-append-version="true"></script>
}
