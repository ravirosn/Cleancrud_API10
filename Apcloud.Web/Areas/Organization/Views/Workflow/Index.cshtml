@{
    ViewData["Title"] = "Approval workflows";
}

<style>
    [data-workflow-modal] .modal-dialog {
        height: calc(100vh - 2rem);
        margin-top: 1rem;
        margin-bottom: 1rem;
    }

    [data-workflow-modal] .modal-content,
    [data-workflow-modal] .workflow-modal-form {
        max-height: 100%;
        min-height: 0;
    }

    [data-workflow-modal] .workflow-modal-form {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        overflow: hidden;
    }

    [data-workflow-modal] .modal-body {
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    [data-workflow-modal] .modal-header,
    [data-workflow-modal] .modal-footer {
        flex: 0 0 auto;
        background: var(--tblr-bg-surface, #fff);
        z-index: 1;
    }

    @@media (max-width: 991.98px) {
        [data-workflow-modal] .modal-dialog {
            height: calc(100vh - 1rem);
            margin: .5rem;
        }
    }
</style>

<div class="page-header d-print-none mb-4">
    <div class="row g-3 align-items-center">
        <div class="col">
            <h1 class="page-title">Approval workflows</h1>
            <p class="text-secondary mt-2 mb-0">
                Configure module-specific approval levels, scoped workflow types, and notification messages.
            </p>
        </div>
        <div class="col-auto ms-auto">
            <button type="button" class="btn btn-primary" data-workflow-add>
                <svg class="icon"><use href="#icon-plus" /></svg> Add workflow
            </button>
        </div>
    </div>
</div>

<div class="card server-data-grid" data-server-grid
     data-url="workflow-setup?includeInactive=false" data-page-size="10"
     data-search-param="searchTerm" data-server-sort="true"
     data-default-sort="updatedAtUtc" data-default-sort-direction="desc"
     data-row-actions="edit,delete" data-workflow-grid>
    <div class="card-header server-grid-toolbar">
        <div class="server-grid-search" role="search">
            <div class="input-icon">
                <span class="input-icon-addon"><svg class="icon"><use href="#icon-search" /></svg></span>
                <input type="search" class="form-control" data-grid-search
                       placeholder="Search code, module, type, or name…" aria-label="Search workflows" />
            </div>
            <button type="button" class="btn btn-primary" data-grid-search-button>Search</button>
            <button type="button" class="btn btn-outline-secondary" data-grid-clear>Clear</button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label for="workflowPageSize" class="small text-secondary text-nowrap">Rows per page</label>
            <select id="workflowPageSize" class="form-select form-select-sm" data-grid-page-size>
                <option value="10">10</option><option value="25">25</option><option value="50">50</option>
            </select>
        </div>
    </div>
    <div class="server-grid-state" data-grid-loading role="status">
        <span class="spinner-border spinner-border-sm text-primary"></span><span>Loading workflows…</span>
    </div>
    <div class="server-grid-state d-none" data-grid-error role="alert">
        <svg class="icon text-danger"><use href="#icon-alert" /></svg>
        <div><strong>Unable to load workflows</strong><p data-grid-error-message class="mb-0"></p></div>
        <button type="button" class="btn btn-outline-danger ms-auto" data-grid-retry>Try again</button>
    </div>
    <div class="empty py-6 d-none" data-grid-empty>
        <div class="empty-icon"><svg class="icon"><use href="#icon-settings" /></svg></div>
        <p class="empty-title">No workflows found</p>
        <p class="empty-subtitle text-secondary">Create a workflow for an application module or type.</p>
    </div>
    <div class="d-none" data-grid-content>
        <div class="table-responsive server-grid-scroll">
            <table class="table table-vcenter card-table server-grid-table">
                <thead><tr data-grid-head>
                    <th data-grid-column="workflowCode">Workflow code</th>
                    <th data-grid-column="moduleName">Module</th>
                    <th data-grid-column="subjectType">Subject category</th>
                    <th data-grid-column="subjectTypeName">Type</th>
                    <th data-grid-column="name">Workflow</th>
                    <th data-grid-column="levelCount">Levels</th>
                    <th data-grid-column="status">Status</th>
                    <th data-grid-column="updatedAtUtc">Updated</th>
                </tr></thead>
                <tbody data-grid-body></tbody>
            </table>
        </div>
        <div class="card-footer server-grid-footer">
            <p class="m-0 text-secondary" data-grid-summary></p>
            <ul class="pagination m-0 ms-auto" data-grid-pagination></ul>
        </div>
    </div>
</div>

<div class="modal modal-blur fade" tabindex="-1" aria-hidden="true" data-workflow-modal>
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form class="workflow-modal-form" data-workflow-form novalidate>
                <div class="modal-header">
                    <h2 class="modal-title" data-workflow-title>Add approval workflow</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" data-workflow-id />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label required">Application module</label>
                            <select class="form-select" required data-workflow-module><option value="">Select module</option></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label required">Workflow type/category</label>
                            <select class="form-select" required data-workflow-category><option value="">Select category</option></select>
                            <div class="form-hint">Examples: PERMIT_TYPE, TICKET_TYPE, VISIT_TYPE.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Specific type</label>
                            <select class="form-select" disabled data-workflow-subject><option value="">Module-wide default</option></select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label required">Workflow name</label>
                            <input class="form-control" required minlength="2" maxlength="150" data-workflow-name />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label required">Unique workflow code</label>
                            <input class="form-control text-uppercase" required minlength="3" maxlength="100"
                                   pattern="[A-Za-z0-9._-]+" data-workflow-code />
                            <div class="form-hint">Generated from module, category, and type; it can be adjusted before saving.</div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end pb-2">
                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" checked data-workflow-active />
                                <span class="form-check-label">Active</span>
                            </label>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mt-4 mb-2">
                        <div><h3 class="mb-0">Approval levels</h3><small class="text-secondary">Levels execute in order from 1 to 5.</small></div>
                        <button type="button" class="btn btn-sm btn-outline-primary ms-auto" data-level-add>Add level</button>
                    </div>
                    <div class="vstack gap-2" data-workflow-levels></div>

                    <h3 class="mt-4 mb-1">Notification templates</h3>
                    <p class="text-secondary small">Use <code>{Reference}</code> in every template and optional <code>{Level}</code>.</p>
                    <div class="alert alert-info py-2" role="note">
                        Approval-request notifications go to the users assigned for the primary or alternate role at the active level.
                        Final approval and rejection notifications go to the user who submitted the record.
                    </div>
                    <div class="row g-3">
                        <div class="col-lg-4" data-template-group="pending">
                            <div class="card h-100"><div class="card-header"><h4 class="card-title">Approval requested</h4></div><div class="card-body">
                                <label class="form-label required">Title</label><input class="form-control mb-3" maxlength="200" required data-template-title />
                                <label class="form-label required">Message</label><textarea class="form-control" rows="4" maxlength="1000" required data-template-message></textarea>
                            </div></div>
                        </div>
                        <div class="col-lg-4" data-template-group="approved">
                            <div class="card h-100"><div class="card-header"><h4 class="card-title">Final approval</h4></div><div class="card-body">
                                <label class="form-label required">Title</label><input class="form-control mb-3" maxlength="200" required data-template-title />
                                <label class="form-label required">Message</label><textarea class="form-control" rows="4" maxlength="1000" required data-template-message></textarea>
                            </div></div>
                        </div>
                        <div class="col-lg-4" data-template-group="rejected">
                            <div class="card h-100"><div class="card-header"><h4 class="card-title">Rejection</h4></div><div class="card-body">
                                <label class="form-label required">Title</label><input class="form-control mb-3" maxlength="200" required data-template-title />
                                <label class="form-label required">Message</label><textarea class="form-control" rows="4" maxlength="1000" required data-template-message></textarea>
                            </div></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" data-workflow-save>
                        <span data-save-label>Save workflow</span>
                        <span class="d-none" data-saving><span class="spinner-border spinner-border-sm me-2"></span>Saving…</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/organization-workflow.js" asp-append-version="true"></script>
}
