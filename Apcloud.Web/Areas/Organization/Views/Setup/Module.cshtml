@{
    ViewData["Title"] = "Modules";
}

    <div class="page-header d-print-none mb-4">
        <div class="row g-3 align-items-center">
            <div class="col">
                <div class="page-pretitle">Organization setup</div>
                <h1 class="page-title">Modules</h1>
                <p class="text-secondary mt-2 mb-0">
                    Search, add, edit, and deactivate application modules.
                </p>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <button type="button" class="btn btn-primary" data-module-add>
                    <svg class="icon"><use href="#icon-plus" /></svg>
                    Add module
                </button>
            </div>
        </div>
    </div>

    <div class="card server-data-grid"
         data-server-grid
         data-url="modules?includeInactive=false"
         data-page-size="10"
         data-search-param="searchTerm"
         data-row-actions="edit,delete"
         data-module-grid>
        <div class="card-header server-grid-toolbar">
            <div class="server-grid-search" role="search">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <svg class="icon"><use href="#icon-search" /></svg>
                    </span>
                    <input type="search" class="form-control" data-grid-search
                           placeholder="Search modules…" aria-label="Search modules"
                           autocomplete="off" />
                </div>
                <button type="button" class="btn btn-primary" data-grid-search-button>Search</button>
                <button type="button" class="btn btn-outline-secondary" data-grid-clear>Clear</button>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label for="modulePageSize" class="text-secondary small text-nowrap">Rows per page</label>
                <select id="modulePageSize" class="form-select form-select-sm" data-grid-page-size>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>

        <div class="server-grid-state" data-grid-loading role="status">
            <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
            <span>Loading modules…</span>
        </div>

        <div class="server-grid-state d-none" data-grid-error role="alert">
            <span class="server-grid-state-icon text-danger">
                <svg class="icon"><use href="#icon-alert" /></svg>
            </span>
            <div>
                <strong>Unable to load modules</strong>
                <p data-grid-error-message>The module data could not be loaded.</p>
            </div>
            <button type="button" class="btn btn-outline-danger ms-auto" data-grid-retry>
                Try again
            </button>
        </div>

        <div class="empty py-6 d-none" data-grid-empty>
            <div class="empty-icon"><svg class="icon"><use href="#icon-search" /></svg></div>
            <p class="empty-title">No modules found</p>
            <p class="empty-subtitle text-secondary">
                Try another search term or add a new module.
            </p>
            <div class="empty-action">
                <button type="button" class="btn btn-primary" data-module-add>
                    <svg class="icon"><use href="#icon-plus" /></svg>
                    Add module
                </button>
            </div>
        </div>

        <div class="d-none" data-grid-content>
            <div class="table-responsive server-grid-scroll">
                <table class="table table-vcenter card-table server-grid-table">
                    <thead>
                        <tr data-grid-head>
                            <th data-grid-column="code">Code</th>
                            <th data-grid-column="name">Module name</th>
                            <th data-grid-column="status">Status</th>
                            <th data-grid-column="displayOrder">Display order</th>
                            <th data-grid-column="createdAtUtc">Created on</th>
                        </tr>
                    </thead>
                    <tbody data-grid-body></tbody>
                </table>
            </div>
            <div class="card-footer server-grid-footer">
                <p class="m-0 text-secondary" data-grid-summary></p>
                <ul class="pagination m-0 ms-auto" data-grid-pagination></ul>
            </div>
        </div>
    </div>
</div>

<div class="modal modal-blur fade" id="moduleEditorModal" tabindex="-1"
     aria-labelledby="moduleEditorTitle" aria-hidden="true" data-module-modal>
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form data-module-form novalidate>
                <div class="modal-header">
                    <h2 class="modal-title" id="moduleEditorTitle" data-module-modal-title>Add module</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" data-module-id />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="moduleCode" class="form-label required">Code</label>
                            <input id="moduleCode" type="text" class="form-control text-uppercase"
                                   minlength="2" maxlength="30" required data-module-code
                                   autocomplete="off" />
                            <div class="invalid-feedback">Enter a code between 2 and 30 characters.</div>
                        </div>
                        <div class="col-md-8">
                            <label for="moduleName" class="form-label required">Module name</label>
                            <input id="moduleName" type="text" class="form-control"
                                   minlength="2" maxlength="100" required data-module-name
                                   autocomplete="off" />
                            <div class="invalid-feedback">Enter a name between 2 and 100 characters.</div>
                        </div>
                        <div class="col-12">
                            <label for="moduleDescription" class="form-label">Description</label>
                            <textarea id="moduleDescription" class="form-control" rows="3"
                                      maxlength="500" data-module-description></textarea>
                        </div>
                        <div class="col-md-8">
                            <label for="moduleIcon" class="form-label">Icon</label>
                            <input id="moduleIcon" type="text" class="form-control"
                                   maxlength="100" data-module-icon
                                   placeholder="Example: apps" autocomplete="off" />
                        </div>
                        <div class="col-md-4">
                            <label for="moduleDisplayOrder" class="form-label">Display order</label>
                            <input id="moduleDisplayOrder" type="number" class="form-control"
                                   min="0" step="1" value="0" required data-module-display-order />
                            <div class="invalid-feedback">Enter zero or a positive number.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" checked data-module-active />
                                <span class="form-check-label">Active</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" data-module-save>
                        <span data-module-save-label>Save module</span>
                        <span class="d-none" data-module-save-progress>
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            Saving…
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>

@section Scripts {
    <script src="~/js/organization-module.js" asp-append-version="true"></script>
}

