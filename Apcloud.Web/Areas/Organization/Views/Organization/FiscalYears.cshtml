@using Apcloud.Contracts.Permissions
@{
    ViewData["Title"] = "Fiscal years";
}

<div class="page-header d-print-none mb-4">
    <div class="row g-3 align-items-center">
        <div class="col">
            <div class="page-pretitle">Organization setup</div>
            <h1 class="page-title">Fiscal years</h1>
            <p class="text-secondary mt-2 mb-0">Maintain fiscal periods and their risk-assessment and permit numbering settings.</p>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <button type="button" class="btn btn-primary d-none" data-fiscal-year-add>
                <svg class="icon"><use href="#icon-plus" /></svg> Add fiscal year
            </button>
        </div>
    </div>
</div>

<div class="alert alert-info" role="note">
    Only one fiscal year can be active. Close the current active fiscal year before activating another one; closed fiscal years are read-only.
</div>

<div class="card server-data-grid" data-server-grid data-fiscal-year-grid
     data-url="organization/fiscal-years?includeInactive=true" data-page-size="10"
     data-search-param="search" data-server-sort="true" data-default-sort="startDate"
     data-default-sort-direction="desc" data-row-actions=""
     data-permission-module="@ApplicationPermissions.OrganizationModule"
     data-permission-controller="Organization" data-permission-action="FiscalYears"
     data-permission-create="@ApplicationPermissions.FiscalYears.Create"
     data-permission-edit="@ApplicationPermissions.FiscalYears.Edit"
     data-permission-close="@ApplicationPermissions.FiscalYears.Close"
     data-permission-delete="@ApplicationPermissions.FiscalYears.Delete">
    <div class="card-header server-grid-toolbar">
        <div class="server-grid-search" role="search">
            <div class="input-icon">
                <span class="input-icon-addon"><svg class="icon"><use href="#icon-search" /></svg></span>
                <input type="search" class="form-control" data-grid-search placeholder="Search fiscal years or numbering settings…"
                       aria-label="Search fiscal years" autocomplete="off" />
            </div>
            <button type="button" class="btn btn-primary" data-grid-search-button>Search</button>
            <button type="button" class="btn btn-outline-secondary" data-grid-clear>Clear</button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label for="fiscalYearPageSize" class="text-secondary small text-nowrap">Rows per page</label>
            <select id="fiscalYearPageSize" class="form-select form-select-sm" data-grid-page-size>
                <option value="10" selected>10</option><option value="25">25</option><option value="50">50</option>
            </select>
        </div>
    </div>
    <div class="server-grid-state" data-grid-loading role="status"><span class="spinner-border spinner-border-sm text-primary"></span><span>Loading fiscal years…</span></div>
    <div class="server-grid-state d-none" data-grid-error role="alert">
        <span class="server-grid-state-icon text-danger"><svg class="icon"><use href="#icon-alert" /></svg></span>
        <div><strong>Unable to load fiscal years</strong><p data-grid-error-message>The fiscal year data could not be loaded.</p></div>
        <button type="button" class="btn btn-outline-danger ms-auto" data-grid-retry>Try again</button>
    </div>
    <div class="empty py-6 d-none" data-grid-empty>
        <div class="empty-icon"><svg class="icon"><use href="#icon-search" /></svg></div>
        <p class="empty-title">No fiscal years found</p>
        <p class="empty-subtitle text-secondary">Try another search term or add a fiscal year.</p>
        <div class="empty-action"><button type="button" class="btn btn-primary d-none" data-fiscal-year-add><svg class="icon"><use href="#icon-plus" /></svg>Add fiscal year</button></div>
    </div>
    <div class="d-none" data-grid-content>
        <div class="table-responsive server-grid-scroll organization-grid-scroll">
            <table class="table table-vcenter card-table server-grid-table">
                <thead><tr data-grid-head>
                    <th data-grid-column="displayName">Fiscal year</th>
                    <th data-grid-column="startDate">Start date</th>
                    <th data-grid-column="endDate">End date</th>
                    <th data-grid-column="raPrefix">RA prefix</th>
                    <th data-grid-column="nextRaNumber">Next RA no.</th>
                    <th data-grid-column="paPrefix">PA prefix</th>
                    <th data-grid-column="nextPaNumber">Next PA no.</th>
                    <th data-grid-column="status">Status</th>
                </tr></thead>
                <tbody data-grid-body></tbody>
            </table>
        </div>
        <div class="card-footer server-grid-footer"><p class="m-0 text-secondary" data-grid-summary></p><ul class="pagination m-0 ms-auto" data-grid-pagination></ul></div>
    </div>
</div>

<div class="modal modal-blur fade" id="fiscalYearEditorModal" tabindex="-1" aria-labelledby="fiscalYearEditorTitle" aria-hidden="true" data-fiscal-year-modal>
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form data-fiscal-year-form novalidate>
                <div class="modal-header"><h2 class="modal-title" id="fiscalYearEditorTitle" data-fiscal-year-title>Add fiscal year</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12"><label for="fiscalYearDisplayName" class="form-label required">Display name</label><input id="fiscalYearDisplayName" class="form-control" maxlength="100" required data-fiscal-year-name /><div class="invalid-feedback">Enter the fiscal year display name.</div></div>
                        <div class="col-md-6"><label for="fiscalYearStartDate" class="form-label required">Start date</label><input id="fiscalYearStartDate" type="date" class="form-control" required data-fiscal-year-start /><div class="invalid-feedback">Enter the start date.</div></div>
                        <div class="col-md-6"><label for="fiscalYearEndDate" class="form-label required">End date</label><input id="fiscalYearEndDate" type="date" class="form-control" required data-fiscal-year-end /><div class="invalid-feedback">Enter an end date on or after the start date.</div></div>
                        <div class="col-12"><hr class="my-1" /><h3 class="h4 mb-0">Numbering settings</h3></div>
                        <div class="col-md-6"><label for="fiscalYearRaPrefix" class="form-label required">RA prefix</label><input id="fiscalYearRaPrefix" class="form-control" maxlength="50" required data-fiscal-year-ra-prefix /></div>
                        <div class="col-md-6"><label for="fiscalYearNextRaNumber" class="form-label required">Next RA number</label><input id="fiscalYearNextRaNumber" class="form-control" maxlength="50" required data-fiscal-year-next-ra /></div>
                        <div class="col-md-6"><label for="fiscalYearPaPrefix" class="form-label required">PA prefix</label><input id="fiscalYearPaPrefix" class="form-control" maxlength="50" required data-fiscal-year-pa-prefix /></div>
                        <div class="col-md-6"><label for="fiscalYearNextPaNumber" class="form-label required">Next PA number</label><input id="fiscalYearNextPaNumber" class="form-control" maxlength="50" required data-fiscal-year-next-pa /></div>
                        <div class="col-md-6"><label class="form-check form-switch"><input type="checkbox" class="form-check-input" data-fiscal-year-active /><span class="form-check-label">Active</span></label></div>
                        <div class="col-md-6 d-none" data-fiscal-year-close-container><label class="form-check form-switch"><input type="checkbox" class="form-check-input" data-fiscal-year-closed /><span class="form-check-label">Close fiscal year permanently</span></label></div>
                        <div class="col-12 d-none" data-fiscal-year-close-warning><div class="alert alert-warning mb-0">Closing makes this fiscal year read-only and cannot be undone.</div></div>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary" data-fiscal-year-save><span data-fiscal-year-save-label>Add fiscal year</span><span class="d-none" data-fiscal-year-saving><span class="spinner-border spinner-border-sm me-2"></span>Saving…</span></button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/fiscal-year-administration.js" asp-append-version="true"></script>
}
