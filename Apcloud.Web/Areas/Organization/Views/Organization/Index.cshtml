@{
    ViewData["Title"] = "Organization";
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <div class="page-pretitle">Administration</div>
            <h1 class="page-title">Organization</h1>
            <p class="text-secondary mt-2 mb-0">
                Manage organization information and access-control setup.
            </p>
        </div>
    </div>
</div>

<div class="row row-cards">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <span class="avatar bg-blue-lt mb-3" aria-hidden="true">
                    <svg class="icon"><use href="#icon-users" /></svg>
                </span>
                <h2 class="card-title">Role</h2>
                <p class="text-secondary">
                    Configure the roles used to control access across the organization.
                </p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-area="Organization" asp-controller="Setup" asp-action="Role"
                   class="btn btn-outline-primary">
                    Open role setup
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <span class="avatar bg-purple-lt mb-3" aria-hidden="true">
                    <svg class="icon"><use href="#icon-apps" /></svg>
                </span>
                <h2 class="card-title">Module</h2>
                <p class="text-secondary">
                    Configure application modules and their role assignments.
                </p>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-area="Organization" asp-controller="Setup" asp-action="Module"
                   class="btn btn-outline-primary">
                    Open module setup
                </a>
            </div>
        </div>
    </div>
</div>
