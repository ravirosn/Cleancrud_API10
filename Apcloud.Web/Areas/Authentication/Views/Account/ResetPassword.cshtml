@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
}

<main class="auth-shell">
    <section class="auth-brand-panel" aria-label="Operations Hub password reset">
        <div class="auth-brand-content">
            <a class="auth-brand" href="/" aria-label="Operations Hub home"><span class="auth-brand-mark">O</span><span>Operations Hub</span></a>
            <div class="auth-message"><span class="auth-eyebrow">Secure account recovery</span><h1>Create a new password.</h1><p>Your reset link is single-use and expires automatically.</p></div>
        </div>
    </section>
    <section class="auth-form-panel">
        <div class="login-card">
            <div class="mb-4"><span class="login-kicker">Account recovery</span><h2>Reset password</h2><p>Use at least 12 characters with uppercase, lowercase, number, and special characters.</p></div>
            <form asp-action="ResetPassword" method="post" novalidate data-login-form>
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><div class="auth-input-wrap"><input asp-for="NewPassword" class="form-control form-control-lg pe-5" autocomplete="new-password" /><button class="password-toggle" type="button" data-password-toggle aria-label="Show password"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.5"/></svg></button></div><span asp-validation-for="NewPassword" class="text-danger small"></span></div>
                <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><div class="auth-input-wrap"><input asp-for="ConfirmPassword" class="form-control form-control-lg pe-5" autocomplete="new-password" /><button class="password-toggle" type="button" data-password-toggle aria-label="Show password"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.5"/></svg></button></div><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
                <button type="submit" class="btn btn-primary btn-lg w-100" data-login-submit><span data-login-label>Reset password</span><span class="d-none" data-login-progress><span class="spinner-border spinner-border-sm me-2"></span>Resetting&hellip;</span></button>
            </form>
        </div>
    </section>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
