@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
    var submitted = ViewData["Submitted"] as bool? == true;
}

<main class="auth-shell">
    <section class="auth-brand-panel" aria-label="Operations Hub password recovery">
        <div class="auth-brand-content">
            <a class="auth-brand" href="/" aria-label="Operations Hub home"><span class="auth-brand-mark">O</span><span>Operations Hub</span></a>
            <div class="auth-message"><span class="auth-eyebrow">Secure account recovery</span><h1>Recover access safely.</h1><p>We use time-limited, single-use reset links and never reveal whether an account exists.</p></div>
        </div>
    </section>
    <section class="auth-form-panel">
        <div class="login-card">
            <div class="mb-4"><span class="login-kicker">Account recovery</span><h2>Forgot your password?</h2><p>Enter your username or email address.</p></div>
            @if (submitted)
            {
                <div class="alert alert-success" role="status">If a matching active account exists, reset instructions have been added to the email queue.</div>
                <a asp-action="Login" class="btn btn-primary btn-lg w-100">Return to sign in</a>
            }
            else
            {
                <form asp-action="ForgotPassword" method="post" novalidate data-login-form>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-4"><label asp-for="UserNameOrEmail" class="form-label"></label><input asp-for="UserNameOrEmail" class="form-control form-control-lg" autocomplete="username" autofocus /><span asp-validation-for="UserNameOrEmail" class="text-danger small"></span></div>
                    <button type="submit" class="btn btn-primary btn-lg w-100" data-login-submit><span data-login-label>Send reset instructions</span><span class="d-none" data-login-progress><span class="spinner-border spinner-border-sm me-2"></span>Submitting&hellip;</span></button>
                    <a asp-action="Login" class="btn btn-link w-100 mt-2">Back to sign in</a>
                </form>
            }
        </div>
    </section>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
