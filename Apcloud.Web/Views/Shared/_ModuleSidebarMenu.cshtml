@model IReadOnlyList<Apcloud.Web.Areas.Portal.Models.NavigationMenuViewModel>

@foreach (var menu in Model)
{
    var collapseId = $"module-menu-{menu.Id.GetHashCode():X}";
    <li class="nav-item @(menu.Children.Count > 0 ? "dropdown" : null)">
        @if (menu.Children.Count > 0)
        {
            <a class="nav-link dropdown-toggle @(menu.IsCurrent ? "active" : null)" href="#@collapseId" data-bs-toggle="collapse" aria-expanded="@(menu.IsCurrent ? "true" : "false")" aria-controls="@collapseId">
                <span class="nav-link-icon"><span class="module-nav-letter">@char.ToUpperInvariant(menu.Name[0])</span></span>
                <span class="nav-link-title">@menu.Name</span>
            </a>
            <div class="collapse @(menu.IsCurrent ? "show" : null)" id="@collapseId">
                <ul class="navbar-nav module-nav-children">
                    <partial name="_ModuleSidebarMenu" model="menu.Children" />
                </ul>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(menu.Url))
        {
            <a class="nav-link @(menu.IsCurrent ? "active" : null)" href="@menu.Url">
                <span class="nav-link-icon"><span class="module-nav-letter">@char.ToUpperInvariant(menu.Name[0])</span></span>
                <span class="nav-link-title">@menu.Name</span>
            </a>
        }
        else
        {
            <span class="nav-link disabled">
                <span class="nav-link-icon"><span class="module-nav-letter">@char.ToUpperInvariant(menu.Name[0])</span></span>
                <span class="nav-link-title">@menu.Name</span>
            </span>
        }
    </li>
}
