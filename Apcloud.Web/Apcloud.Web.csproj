<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Apcloud.Web</AssemblyName>
    <RootNamespace>Apcloud.Web</RootNamespace>
    <UserSecretsId>Apcloud-Web-Local-Development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Apcloud.Contracts\Apcloud.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
  </ItemGroup>

  <Target Name="CopyTablerAssets" BeforeTargets="Build" Condition="Exists('..\node_modules\@tabler\core\dist\css\tabler.min.css')">
    <Exec WorkingDirectory=".." Command="npm run copy:tabler" />
  </Target>

</Project>
