{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "CleanCrudAPI",
    "Audience": "CleanCrudClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenAbsoluteDays": 30
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "YOUR_ENTRA_TENANT_ID",
    "ClientId": "YOUR_API_APP_REGISTRATION_CLIENT_ID",
    "Scopes": "access_as_user"
  },
  "EntraProvisioning": {
    "AutoProvisionUsers": true,
    "DefaultModuleCodes": [ "PERMIT", "VISITOR" ]
  },
  "PowerBi": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "WorkspaceId": "",
    "ReportId": ""
  },
  "AllowedHosts": "*"
}
